CHATWOOT_IMAGE=chatwoot/chatwoot:v4.20.1
SECRET_KEY_BASE=GENERATE_WITH_SETUP
POSTGRES_PASSWORD=GENERATE_WITH_SETUP
REDIS_PASSWORD=GENERATE_WITH_SETUP
FRONTEND_URL=http://localhost:3000
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
POSTGRES_HOST=postgres
POSTGRES_DATABASE=chatwoot_production
POSTGRES_USERNAME=postgres
REDIS_URL=redis://redis:6379
ACTIVE_STORAGE_SERVICE=local
RAILS_LOG_TO_STDOUT=true
ENABLE_ACCOUNT_SIGNUP=false
ENABLE_PUSH_RELAY_SERVER=false
MAILER_SENDER_EMAIL=Demo Support <support@example.com>
SMTP_ADDRESS=mailpit
SMTP_PORT=1025
SMTP_AUTHENTICATION=
SMTP_ENABLE_STARTTLS_AUTO=false
SMTP_OPENSSL_VERIFY_MODE=none
FORCE_SSL=false
BOT_WEBHOOK_SECRET=GENERATE_WITH_SETUP
CHATWOOT_URL=http://rails:3000
# Fill these after creating your local Chatwoot account and inbox.
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1
CHATWOOT_API_TOKEN=
# faq works without a model. ollama uses a local model to select approved FAQs.
BOT_MODE=faq
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:1.5b
